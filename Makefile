# Compiler and archiving tools
CC      := clang
AR       = ar
ARFLAGS  = rcs

# ISA flags needed by the AVX/FMA intrinsics in mat.c
SIMD_FLAGS = -mavx2 -mfma -march=native

CFLAGS   = -Wall -Wextra -O3 -fopenmp -MMD -MP -fPIE \
	$(SIMD_FLAGS) -ffast-math -I$(INC_DIR) -I$(SRC_DIR)
LDFLAGS  = -fopenmp -lm

# Sanitizer flags (clang)
TSAN_FLAGS = -fsanitize=thread -g -O1 -fno-omit-frame-pointer
UBSAN_FLAGS = -fsanitize=undefined -g -O1 -fno-omit-frame-pointer

# Directories
SRC_DIR    = src
INC_DIR    = include
BUILD_DIR  = build
BIN_DIR    = $(BUILD_DIR)/bin
NEURON_DIR = $(SRC_DIR)/neurons
GATES_DIR  = $(NEURON_DIR)/gates
MNIST_DIR  = $(NEURON_DIR)/mnist

# Matrix static library
TARGET_MAT = $(BUILD_DIR)/libmat.a
MAT_SRCS   = $(SRC_DIR)/mat.c $(SRC_DIR)/rng.c
MAT_OBJS   = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/mat/%.o, $(MAT_SRCS))

# Gates executable
TARGET_GATES = $(BIN_DIR)/gates
GATES_SRCS   = $(wildcard $(GATES_DIR)/*.c) \
	$(SRC_DIR)/activation.c \
	$(SRC_DIR)/rng.c
GATES_OBJS   = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/gates/%.o, $(GATES_SRCS))

# MNIST executable
TARGET_MNIST = $(BIN_DIR)/mnist
MNIST_SRCS   = $(MNIST_DIR)/mnist.c \
	$(SRC_DIR)/activation.c \
	$(SRC_DIR)/rng.c
MNIST_OBJS   = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/mnist/%.o, $(MNIST_SRCS))

# MNIST dataset paths
MNIST_DATA_DIR ?= $(MNIST_DIR)/data
MNIST_ARGS     ?= $(MNIST_DATA_DIR)/train-images-idx3-ubyte \
                  $(MNIST_DATA_DIR)/train-labels-idx1-ubyte \
                  $(MNIST_DATA_DIR)/t10k-images-idx3-ubyte \
                  $(MNIST_DATA_DIR)/t10k-labels-idx1-ubyte

# Test targets
TEST_DIR        = tests
TEST_SRCS       = $(filter-out $(TEST_DIR)/a.c,$(wildcard $(TEST_DIR)/*.c))
TEST_HDRS       = $(wildcard $(TEST_DIR)/*.h) $(wildcard $(SRC_DIR)/*.h) $(wildcard $(INC_DIR)/*.h)
TEST_BIN        = $(BIN_DIR)/run_tests
TEST_TSAN_BIN   = $(BIN_DIR)/run_tests_tsan
TEST_UBSAN_BIN  = $(BIN_DIR)/run_tests_ubsan
TEST_CFLAGS     = -Wall -Wextra -O3 -g -fopenmp -I$(INC_DIR) -I$(SRC_DIR) $(SIMD_FLAGS)

# Benchmark target
BENCH_DIR = bench
BENCH_SRC = $(BENCH_DIR)/benchmark.c
BENCH_BIN = $(BIN_DIR)/bench

# Include all generated .d dependency files that already exist
ALL_OBJS = $(MAT_OBJS) $(GATES_OBJS) $(MNIST_OBJS)
DEPS     = $(wildcard $(ALL_OBJS:.o=.d))

.PHONY: all clean mat gates gates-run mnist mnist-run mnist-run-args test test-tsan test-ubsan bench

all: $(BUILD_DIR) $(BIN_DIR) $(TARGET_GATES) $(TARGET_MNIST)

$(BUILD_DIR) $(BIN_DIR):
	mkdir -p $@

# Static matrix library
mat: $(BUILD_DIR) $(TARGET_MAT)

$(TARGET_MAT): $(MAT_OBJS)
	rm -f $@
	$(AR) $(ARFLAGS) $@ $(MAT_OBJS)

# Neuron gates build & run
gates: $(TARGET_GATES)

$(TARGET_GATES): $(GATES_OBJS) $(TARGET_MAT) | $(BIN_DIR)
	$(CC) $(GATES_OBJS) $(TARGET_MAT) -o $@ $(LDFLAGS)

gates-run: $(TARGET_GATES)
	./$(TARGET_GATES)

# MNIST build & run
mnist: $(TARGET_MNIST)

$(TARGET_MNIST): $(MNIST_OBJS) $(TARGET_MAT) | $(BIN_DIR)
	$(CC) $(CFLAGS) $(MNIST_OBJS) $(TARGET_MAT) -o $@ $(LDFLAGS)

mnist-run: $(TARGET_MNIST)
	./$(TARGET_MNIST)

mnist-run-args: $(TARGET_MNIST)
	./$(TARGET_MNIST) $(MNIST_ARGS)

# Generic object compilation rules
$(BUILD_DIR)/mat/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/gates/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/mnist/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Unit tests
$(TEST_BIN): $(TEST_SRCS) $(TEST_HDRS) $(TARGET_MAT) | $(BIN_DIR)
	$(CC) $(TEST_CFLAGS) $(TEST_SRCS) $(TARGET_MAT) -o $@ -lm

test: $(TEST_BIN)
	./$(TEST_BIN)

# ThreadSanitizer tests
$(TEST_TSAN_BIN): $(TEST_SRCS) $(TEST_HDRS)
	mkdir -p $(BIN_DIR)
	$(CC) -Wall -Wextra $(TSAN_FLAGS) $(SIMD_FLAGS) -fopenmp -I$(INC_DIR) -I$(SRC_DIR) \
		$(TEST_SRCS) $(MAT_SRCS) -o $@ -fopenmp -lm

test-tsan: $(TEST_TSAN_BIN)
	TSAN_OPTIONS="ignore_noninstrumented_modules=1" ./$(TEST_TSAN_BIN)

# UndefinedBehaviorSanitizer tests
$(TEST_UBSAN_BIN): $(TEST_SRCS) $(TEST_HDRS)
	mkdir -p $(BIN_DIR)
	$(CC) -Wall -Wextra $(UBSAN_FLAGS) $(SIMD_FLAGS) -fopenmp -I$(INC_DIR) -I$(SRC_DIR) \
		$(TEST_SRCS) $(MAT_SRCS) -o $@ -fopenmp -lm

test-ubsan: $(TEST_UBSAN_BIN)
	UBSAN_OPTIONS=print_stacktrace=1 ./$(TEST_UBSAN_BIN)

# Benchmark
$(BENCH_BIN): $(BENCH_SRC) $(TARGET_MAT) | $(BIN_DIR)
	$(CC) $(CFLAGS) $(BENCH_SRC) $(TARGET_MAT) -o $@ -lm

bench: $(BENCH_BIN)
	OMP_WAIT_POLICY=ACTIVE OMP_NUM_THREADS=6 OMP_PROC_BIND=close OMP_PLACES=cores time -p ./$(BENCH_BIN)

clean:
	rm -rf $(BUILD_DIR)

# Header dependencies generated by -MMD
-include $(DEPS)
